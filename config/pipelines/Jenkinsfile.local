pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'orlandogtp/fastapi-chatbot'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKER = credentials('docker-credentials')
        GIT_REPO = 'https://github.com/DarkCodePE/chatbot-multi-tenant-qdrant.git'  // Ajusta esta URL a tu repositorio
        GIT_BRANCH = 'master'  // Ajusta a tu rama
    }

    stages {
        stage('Clone Repository') {
            steps {
                sh '''
                    echo "=== Limpiando workspace ==="
                    rm -rf *
                '''

                git branch: env.GIT_BRANCH,
                    url: env.GIT_REPO

                sh '''
                    echo "=== Contenido del repositorio ==="
                    ls -la
                '''
            }
        }

        stage('Inject Credentials') {
            steps {
                withCredentials([file(credentialsId: 'google-credentials', variable: 'GOOGLE_CREDENTIALS')]) {
                    sh '''
                        echo "=== Inyectando credenciales de Google ==="
                        mkdir -p config
                        cp $GOOGLE_CREDENTIALS config/google-credentials.json
                        ls -la config
                    '''
                }
            }
        }

        stage('Diagnóstico') {
            steps {
                sh '''
                    echo "=== Verificando ambiente ==="
                    echo "Docker version:"
                    docker --version

                    echo "\\nKubectl version:"
                    kubectl version --client

                    echo "\\nVerificando Dockerfile:"
                    if [ -f Dockerfile ]; then
                        echo "Dockerfile encontrado"
                        cat Dockerfile
                    else
                        echo "ERROR: Dockerfile no encontrado"
                        exit 1
                    fi
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                script {DOCKER_IMAGE
                    try {
                        sh """
                            docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                            docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest
                        """
                    } catch (Exception e) {
                        echo "Error al construir la imagen: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    try {
                        sh '''
                            echo "${DOCKER_PSW}" | docker login -u "${DOCKER_USR}" --password-stdin
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest
                        '''
                    } catch (Exception e) {
                        echo "Error al subir la imagen: ${e.message}"
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline ejecutado exitosamente'
        }
        failure {
            echo 'Pipeline falló'
        }
        always {
            sh '''
                docker logout || true
                docker system prune -f || true
            '''
            cleanWs()
        }
    }
}